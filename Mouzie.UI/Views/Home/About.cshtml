@{
    ViewData["Title"] = "About";
    Layout = "_Layout";
}

<section class="full-page-glass">
  <div class="glass-content-card text-center">
    <h1 class="glass-title">About Mouzie Guest House</h1>
    <p class="lead glass-text">
      A clean, affordable and professional guest house located in the heart of Langa,
      Cape Town. Whether you're here for business, leisure or a short stay, we provide
      a peaceful and welcoming space with all the essentials you need.
    </p>
    <p class="glass-text">
      Each room is thoughtfully furnished with a comfortable bed, fresh linens,
      private bathroom, and reliable Wi-Fi. Our check-in is from 14:00 and check-out
      is by 10:00. Payment is via EFT — banking details are on your invoice.
    </p>
    <div class="mt-4">
        <a asp-controller="Booking" asp-action="Create" class="btn-gold">Book a Room →</a>
    </div>
  </div>
</section>