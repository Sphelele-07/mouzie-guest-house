@{
    ViewData["Title"] = "Terms & Conditions";
    Layout = "_Layout";
}

<section class="full-page-glass" style="align-items: flex-start; padding-top: 100px;">
  <div class="glass-content-card" style="max-width: 800px;">
    <h1 class="glass-title text-center">Terms & Conditions</h1>
    
    <div class="glass-text">
        <p><strong>1. Booking and Payment:</strong> A flat rate of R600 per night applies. Payment is strictly via EFT. Banking details are provided on your invoice.</p>
        <p><strong>2. Check-in / Check-out:</strong> Check-in is from 14:00. Check-out is strictly by 10:00. Early check-out is permitted, but the room must be vacated and keys returned.</p>
        <p><strong>3. Cancellations:</strong> Please notify us at least 48 hours in advance for cancellations. Failure to do so may result in a cancellation fee.</p>
        <p><strong>4. Damages:</strong> Guests are liable for any damages caused to the property during their stay. An additional invoice will be issued for repairs or replacements.</p>
        <p><strong>5. Identification:</strong> A valid South African ID or Passport is required upon booking and check-in.</p>
        <p><strong>6. House Rules:</strong> No smoking indoors. No excessive noise after 22:00. Visitors are not permitted to stay overnight unless added to the booking.</p>
    </div>

    <div class="text-center mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn-outline-gold">← Back to Home</a>
    </div>
  </div>
</section>