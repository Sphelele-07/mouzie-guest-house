@{
    Layout = "_Layout";
    ViewBag.Title = "Create Account";
}

<section class="access-denied-page">
    <div class="access-denied-card">
        <span class="access-code">SETUP</span>
        <h1 style="margin-top: 15px;">Create Account.</h1>
        
        @if (ViewBag.Error != null)
        {
            <p style="color: var(--error); font-size: 13px; margin-bottom: 15px;">@ViewBag.Error</p>
        }
        @if (ViewBag.Success != null)
        {
            <p style="color: var(--success); font-size: 13px; margin-bottom: 15px;">@ViewBag.Success</p>
        }

        <form method="post" asp-controller="Account" asp-action="Register" style="display: flex; flex-direction: column; gap: 15px; text-align: left;">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label>Username</label>
                <input type="text" name="username" required />
            </div>
            <div class="form-group">
                <label>Password</label>
                <input type="password" name="password" required minlength="8" />
            </div>
            <div class="form-group">
                <label>Confirm Password</label>
                <input type="password" name="confirmPassword" required minlength="8" />
            </div>
            <button type="submit" class="btn btn-primary" style="margin-top: 10px;">Register</button>
        </form>
    </div>
</section>