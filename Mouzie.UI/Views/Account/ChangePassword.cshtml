@model Mouzie.Data.Models.ViewModels.ChangePasswordVM
@{
    ViewData["Title"] = "Change Password";
    Layout = "_AdminLayout";
}

<div class="page-header">
    <h1>Change Password</h1>
</div>

@if (TempData["Success"] is string ok)
{
    <div class="success-banner" role="status">@ok</div>
}

<form asp-action="ChangePassword" method="post" class="form-card" novalidate>
    @Html.AntiForgeryToken()

    <label asp-for="CurrentPassword">Current password</label>
    <input asp-for="CurrentPassword" type="password" autocomplete="current-password" required class="input" />
    <span asp-validation-for="CurrentPassword" class="field-error"></span>

    <label asp-for="NewPassword">New password</label>
    <input asp-for="NewPassword" id="np" type="password" autocomplete="new-password" required minlength="8" class="input" />
    <div class="pw-strength" aria-hidden="true"><span></span></div>
    <span asp-validation-for="NewPassword" class="field-error"></span>

    <label asp-for="ConfirmPassword">Confirm new password</label>
    <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required class="input" />
    <span asp-validation-for="ConfirmPassword" class="field-error"></span>

    <button type="submit" class="btn-primary">
        <span class="btn-spinner" hidden></span> Update Password
    </button>
</form>

@section Scripts {
    <script>
        const np = document.getElementById('np');
        const bar = document.querySelector('.pw-strength span');
        np?.addEventListener('input', () => {
          const v = np.value;
          let s = 0;
          if (v.length >= 8) s++;
          if (/[A-Z]/.test(v)) s++;
          if (/[0-9]/.test(v)) s++;
          if (/[^A-Za-z0-9]/.test(v)) s++;
          bar.style.width = (s * 25) + '%';
          bar.style.background = ['#c0392b','#e67e22','#f1c40f','#2ecc71'][Math.max(0,s-1)];
        });
    </script>
}