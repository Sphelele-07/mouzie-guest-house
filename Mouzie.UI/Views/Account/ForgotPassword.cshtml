@{
    Layout = "_Layout";
    ViewBag.Title = "Forgot Password";
}

<section class="access-denied-page">
    <div class="access-denied-card">
        <span class="access-code">RECOVERY</span>
        <h1 style="margin-top: 15px;">Reset Password.</h1>
        
        @if (ViewBag.Success != null)
        {
            <p style="color: var(--success); font-size: 13px; margin-bottom: 15px;">@ViewBag.Success</p>
        }

        <form method="post" asp-controller="Account" asp-action="ForgotPassword" style="display: flex; flex-direction: column; gap: 15px; text-align: left;">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label>Username</label>
                <input type="text" name="username" required />
            </div>
            <button type="submit" class="btn btn-primary" style="margin-top: 10px;">Send Reset Link</button>
            <div style="text-align: center; margin-top: 15px; font-size: 12px;">
                <a href="/Account/Login" style="color: var(--text-muted);">Back to Login</a>
            </div>
        </form>
    </div>
</section>