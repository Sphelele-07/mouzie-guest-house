@model Mouzie.Data.Models.Domain.Booking
@{
    ViewData["Title"] = "Booking received";
    Layout = "_Layout";
    var waNumber = (ViewBag.WhatsAppNumber as string ?? "").Replace("+", "").Replace(" ", "");
    var waText = Uri.EscapeDataString(
        $"Hi Mouzie, I just booked Room {Model.Room?.RoomNumber ?? Model.RoomId.ToString()} on " +
        $"{Model.BookingDate:dd MMM yyyy}. My booking code is {Model.BookingCode}.");
}

<section class="booking-page">
  <div class="booking-glass-card success-glass-card">
    <div class="success-icon">
      <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#b8942e" stroke-width="2">
        <circle cx="12" cy="12" r="10"/>
        <polyline points="7 12 10.5 15.5 17 9"/>
      </svg>
    </div>
    
    <h1>Booking Received</h1>
    <p class="booking-sub">Thanks, @Model.GuestName! Ta Shoes will review your booking shortly.</p>

    <div class="booking-code-box">
      <p>Your booking code</p>
      <p class="code">@Model.BookingCode</p>
      <p class="hint">Check your email — we've sent a confirmation with this code.</p>
    </div>

    <div class="success-details">
      <p><strong>Room:</strong> @(Model.Room?.RoomNumber ?? Model.RoomId.ToString())</p>
      <p><strong>Date:</strong> @Model.BookingDate.ToString("dddd, dd MMM yyyy")</p>
      <p><strong>Check-in:</strong> from 14:00</p>
      <p><strong>Check-out:</strong> by 10:00</p>
    </div>

    <div class="success-actions">
        <a class="btn-whatsapp" href="https://wa.me/@waNumber?text=@waText" target="_blank" rel="noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.5 3.5A11.5 11.5 0 0 0 2 17.5L1 22l4.5-1A11.5 11.5 0 1 0 20.5 3.5zM12 20a8 8 0 0 1-4-1.1l-.3-.2-2.7.6.6-2.6-.2-.3a8 8 0 1 1 6.6 3.6zm4.4-5.8c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.5 6.5 0 0 1-3.2-2.8c-.1-.2 0-.4.1-.5l.4-.5.2-.4v-.4l-.8-2c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.2-.9.9-.9 2.1 0 1.2.9 2.4 1 2.6.2.2 1.8 2.8 4.4 3.9 2.6 1.1 2.6.7 3.1.7.5 0 1.4-.6 1.6-1.1.2-.5.2-1 .1-1.1-.1-.2-.3-.2-.5-.3z"/>
          </svg>
          WhatsApp us
        </a>

        <a asp-controller="Home" asp-action="Index" class="btn-outline-gold">← Back to home</a>
    </div>
  </div>
</section>