@model Mouzie.Data.Models.ViewModels.RoomEditVM
@{
    ViewData["Title"] = Model.RoomId > 0 ? "Edit Room" : "Add Room";
    Layout = "_AdminLayout";
}

<div class="page-header">
  <h1>@ViewData["Title"]</h1>
</div>

<form asp-action="RoomEdit" method="post" class="form-card">
  @Html.AntiForgeryToken()
  <input type="hidden" asp-for="RoomId" />

  <label asp-for="RoomNumber">Room Number</label>
  <input asp-for="RoomNumber" class="input" required />

  <label asp-for="RoomType">Room Type</label>
  <input asp-for="RoomType" class="input" required />

  <label asp-for="PricePerNight">Price Per Night (R)</label>
  <input asp-for="PricePerNight" type="number" step="0.01" class="input" required />

  <label asp-for="Status">Status</label>
  <select asp-for="Status" class="input">
    <option value="Available">Available</option>
    <option value="Occupied">Occupied</option>
    <option value="Maintenance">Maintenance</option>
  </select>

  <label asp-for="RoomKeyCode">Room Key / Lockbox Code (optional)</label>
  <input asp-for="RoomKeyCode" class="input" />

  <label asp-for="ImagePath">Image Path (e.g., /images/rooms/Bedroom-01.png)</label>
  <input asp-for="ImagePath" class="input" />

  <div style="margin-top:24px;">
    <button type="submit" class="btn-primary">Save Room</button>
    <a asp-action="Rooms" class="btn-ghost" style="color:var(--ink); border-color:#ccc;">Cancel</a>
  </div>
</form>