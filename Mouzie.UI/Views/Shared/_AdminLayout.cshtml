<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] — Mouzie Admin</title>
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="admin-body">
  <header class="admin-header">
    <a class="brand" asp-controller="Admin" asp-action="Index">
      <img src="~/images/Mouzie Logo.png" alt="Mouzie Guest House" class="brand-logo" style="height: 40px; filter: brightness(0) invert(1);" />
      <span style="margin-left: 10px; font-size: 12px; letter-spacing: 2px; text-transform: uppercase; color: #b8942e;">Admin</span>
    </a>

    <nav class="admin-nav">
      <a asp-controller="Admin" asp-action="Index">Dashboard</a>
      <a asp-controller="Admin" asp-action="Bookings">Bookings</a>
      <a asp-controller="Admin" asp-action="Rooms">Rooms</a>
      <a asp-controller="Admin" asp-action="Damages">Damages</a>
      <a asp-controller="Admin" asp-action="Profile">Profile</a>
      <a asp-controller="Admin" asp-action="Settings">Settings</a>

      <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn-ghost" title="Sign out">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
            <polyline points="16 17 21 12 16 7"/>
            <line x1="21" y1="12" x2="9" y2="12"/>
          </svg>
          <span class="logout-text">Logout</span>
        </button>
      </form>
    </nav>
  </header>

  <main class="admin-main">
    @if (TempData["Success"] is string successMsg)
    {
      <div class="success-banner" role="status">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 6px;">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
          <polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
        @successMsg
      </div>
    }

    @if (TempData["Error"] is string errorMsg)
    {
      <div class="error-banner" role="alert">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 6px;">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        @errorMsg
      </div>
    }

    @RenderBody()
  </main>

  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>